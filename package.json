{
  "name": "cyclone",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "build:analyze": "npm run build && vite-bundle-visualizer --open true",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "prepare": "husky",
    "generate": "plop --plopfile plopfile.ts"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/sora": "^5.2.8",
    "@mantine/core": "^7.17.0",
    "@mantine/hooks": "^7.17.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "i18next": "^26.0.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.4",
    "immer": "^11.1.6",
    "jsx": "^0.9.89",
    "mantine-datatable": "^7.3.3",
    "music-metadata": "^11.12.3",
    "p-limit": "^7.3.0",
    "plop": "^4.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.4",
    "reselect": "^5.1.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.14.0",
    "@eslint-react/eslint-plugin": "^1.53.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.4",
    "browserslist": "^4.28.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "sass": "^1.86.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.1",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-checker": "^0.13.0",
    "vitest": "^4.1.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs,json,css,scss,md,html}": [
      "prettier --write"
    ]
  }
}
